# Copy this file to .env.platform only for current-platform authorized configuration.
# Never copy credentials from a historical project. .env.platform is ignored by Git.
PLATFORM_PORT=4313
# 只有需要把数据放到别处时才取消注释，并改成真实的绝对路径；
# 保留 /absolute/... 这类示例值会让 Runtime 启动失败（不是可用的目录）。
# PLATFORM_DATA_DIR=/Users/you/path/for/this/platform-only
PLATFORM_MODEL_ENABLED=false
# PLATFORM_MODEL_BASE_URL=https://your-authorized-provider.example/v1
# PLATFORM_MODEL_NAME=your-model
# PLATFORM_MODEL_API_KEY=configure-locally-do-not-share
# PLATFORM_ALLOWED_ORIGINS=http://127.0.0.1:4310,http://127.0.0.1:4311,http://127.0.0.1:4312,http://127.0.0.1:4316

# 元宝搜索（腾讯云 WSA）。Key 取自腾讯云控制台「元宝搜索 → 概览 → 服务 API KEY 方式」，
# 形如 sk-xxxxxxxx，仅创建时可复制。只在 Runtime 侧读取，前端不会接触。
# 未填写时，TRACE 显示 BLOCKED_SEARCH_NOT_CONFIGURED 并拒绝给出联网结论，绝不伪造搜索结果。
PLATFORM_WSA_ENABLED=true
# PLATFORM_WSA_API_KEY=sk-configure-locally-do-not-share
# PLATFORM_WSA_ENDPOINT=https://api.wsa.cloud.tencent.com/SearchPro
# PLATFORM_WSA_TIMEOUT_MS=20000
# PLATFORM_WSA_MAX_ATTEMPTS=3
# PLATFORM_WSA_MAX_QUERIES_PER_FACT=3
# PLATFORM_WSA_TOP_K=8
# PLATFORM_TRACE_FETCH_ENABLED=true
# PLATFORM_TRACE_FETCH_TIMEOUT_MS=12000
# PLATFORM_TRACE_FETCH_MAX_BYTES=1200000
